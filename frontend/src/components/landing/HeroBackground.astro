---
// HeroBackground component - provides background image for Hero
import BlurImage from '../lib/BlurImage.astro';
---

<!-- Hero Background -->
<div class="absolute inset-0 w-full h-full">
  <div class="w-full h-full">
    <BlurImage 
      src="https://images.pexels.com/photos/3354648/pexels-photo-3354648.jpeg"
      alt="Dyprod Autos Hero Background"
    />
  </div>
  <!-- Overlay for better text readability -->
  <div class="absolute inset-0 bg-primary/70"></div>
</div> 

